{
  "name": "jellewijma-portfolio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test:downloadvideo": "node --test services/downloadvideo/test.mjs services/downloadvideo/oidc.test.mjs",
    "build": "npm run optimize:images && npm run build:css && npm run sync:public-assets && next build",
    "build:css": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.generated.css --minify",
    "deploy:convex": "convex deploy",
    "dev:css": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.generated.css --watch",
    "optimize:images": "node scripts/optimize-images.mjs",
    "sync:public-assets": "node scripts/sync-public-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "npm run build && npm run check:assets && npm audit --audit-level=moderate",
    "vercel-build": "npm run build",
    "dev": "npm run optimize:images && npm run build:css && npm run sync:public-assets && next dev",
    "build:next": "next build",
    "start": "next start"
  },
  "overrides": {
    "postcss": "8.5.33"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.4.0",
    "@vercel/microfrontends": "2.4.2",
    "@vercel/speed-insights": "^2.1.0",
    "convex": "^1.50.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
